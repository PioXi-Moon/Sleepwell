@import "../../styles/nightcat.wxss";

.counselor-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 36rpx;
}

.counselor-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid rgba(42, 74, 66, 0.6);
  border-radius: 27rpx;
  background: rgba(12, 43, 40, 0.58);
  text-align: left;
}

.counselor-card.is-active {
  border-color: rgba(239, 224, 168, 0.85);
  background: rgba(11, 43, 39, 0.9);
}

.counselor-avatar {
  flex: none;
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
}

.counselor-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 24rpx;
}

.counselor-name {
  color: var(--cat-title);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.counselor-desc {
  margin-top: 6rpx;
  color: var(--cat-sub);
  font-size: 24rpx;
  line-height: 34rpx;
}

.counselor-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.counselor-tag {
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(42, 74, 66, 0.8);
  border-radius: 21rpx;
  background: rgba(14, 58, 52, 0.55);
  color: #a9bcaf;
  font-size: 21rpx;
  line-height: 27rpx;
}

.counselor-card.is-active .counselor-tag {
  border-color: rgba(240, 223, 160, 0.5);
  background: rgba(240, 223, 160, 0.14);
  color: #f2e4b4;
}

.counselor-go {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-left: 12rpx;
}

.is-pressed {
  opacity: 0.72;
}
