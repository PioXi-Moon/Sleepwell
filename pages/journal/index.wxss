.journal-page { min-height: 100vh; }
.topbar-label { color: var(--text-soft); font-size: 24rpx; letter-spacing: 2rpx; }.topbar-spacer { width: 80rpx; }
.journal-content { padding: 56rpx 48rpx; }.journal-form { margin: 52rpx 0 36rpx; border-top: 1rpx solid var(--line); }.journal-input-row { display: grid; grid-template-columns: 60rpx 1fr; gap: 18rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }.journal-number { padding-top: 21rpx; color: var(--text-faint); font-size: 20rpx; }.journal-input-row .form-textarea { min-height: 112rpx; border: 0; background: transparent; }.input-placeholder { color: rgba(255,255,255,.2); }.saved-tip { display: block; margin-top: 22rpx; color: var(--accent); font-size: 23rpx; text-align: center; }.past-section { margin-top: 74rpx; }.past-title { color: var(--text-faint); font-size: 23rpx; }.past-entry { padding: 30rpx 0; border-bottom: 1rpx solid var(--line); }.past-date, .past-line { display: block; }.past-date { margin-bottom: 14rpx; color: var(--text-faint); font-size: 21rpx; }.past-line { margin-top: 8rpx; color: var(--text-soft); line-height: 1.65; }
