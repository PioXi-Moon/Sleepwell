page { background: #031819; }
.record-page { height: 100vh; overflow: hidden; color: #f3f1e7; background: #031819; font-family: -apple-system, 'Microsoft YaHei', sans-serif; letter-spacing: 0; }
.record-page button { margin: 0; padding: 0; background: transparent; color: inherit; border-radius: 0; line-height: 1.4; font-size: 14px; }
.record-page button::after { border: 0; }
.record-scroll { height: 100%; }
.record-content { padding-bottom: calc(164rpx + env(safe-area-inset-bottom)); }
.record-header { position: relative; height: 300rpx; }
.header-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.header-copy { position: relative; display: flex; flex-direction: column; gap: 12rpx; padding: 30rpx 32rpx; max-width: 70%; }
.record-title { font-family: 'Noto Serif SC', 'Songti SC', SimSun, serif; font-size: 28px; line-height: 1.5; }
.muted { display: block; color: #a8b9b6; font-size: 12px; line-height: 1.6; white-space: pre-line; }
.record-body { display: flex; flex-direction: column; gap: 28rpx; padding: 0 32rpx; }
.calendar-panel { padding: 20rpx 20rpx 24rpx; border: 1px solid #395250; border-radius: 36rpx; background: rgba(11,37,37,.94); box-shadow: 0 0 32rpx rgba(121,187,135,.08); }
.month-nav { display: flex; align-items: center; margin-bottom: 12rpx; }
.month-nav .month-arrow { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.month-arrow image { width: 20px; height: 20px; }
.arrow-left { transform: rotate(180deg); }
.month-label { flex: 1; text-align: center; font-family: SimSun, serif; font-size: 17px; }
.month-nav .month-current { min-width: 40px; height: 44px; color: #ebc979; font-size: 12px; }
.calendar-row { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.weekdays { color: #a8b9b6; font-size: 12px; line-height: 32px; }
.weekdays text,.day-slot { width: 14.2857%; text-align: center; }
.day-slot { display: flex; justify-content: center; }
.record-page .day { position: relative; display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border: 1px solid #395250; border-radius: 50%; font-size: 16px; }
.record-page .day--early { background: rgba(121,187,135,.19); border-color: #79bb87; color: #a8dcb1; }
.record-page .day--middle { background: rgba(229,189,93,.19); border-color: #e5bd5d; color: #ebc979; }
.record-page .day--late { background: rgba(221,98,98,.19); border-color: #dd6262; color: #f19494; }
.record-page .day--other { border-style: dashed; }
.record-page .day--outside { opacity: .36; }
.record-page .day--selected { outline: 2px solid #ebc979; outline-offset: 2px; }
.today-mark { position: absolute; bottom: 5rpx; left: calc(50% - 3rpx); width: 6rpx; height: 6rpx; background: #f3f1e7; border-radius: 50%; }
.legend-title { display: block; margin: 18rpx 0 8rpx; color: #a8b9b6; font-size: 12px; }
.legend { display: flex; flex-wrap: wrap; gap: 8rpx; color: #a8b9b6; font-size: 12px; line-height: 1.8; }
.legend-early { color: #79bb87; }.legend-middle { color: #e5bd5d; margin-left: 10rpx; }.legend-late { color: #dd6262; }
.weekly-banner,.record-page .journal-entry { position: relative; display: flex; align-items: center; min-height: 192rpx; padding: 24rpx 32rpx; border: 1px solid rgba(235,201,121,.65); border-radius: 36rpx; overflow: hidden; }
.banner-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.banner-copy { position: relative; width: 86%; text-align: left; }
.weekly-title { font-size: 17px; line-height: 34px; }.gold-number { color: #ebc979; font-size: 27px; font-family: SimSun, serif; }.weekly-empty { font-size: 16px; line-height: 30px; }
.journal-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.journal-heading > view { flex: 1; min-width: 0; }
.section-title { display: block; font-family: 'Songti SC', SimSun, serif; font-size: 22px; line-height: 1.6; }
.record-page .all-button { display: flex; align-items: center; justify-content: center; min-width: 112rpx; height: 44px; font-size: 12px; border: 1px solid #395250; border-radius: 34rpx; }.all-button image { width: 16px; height: 16px; }
.record-page .journal-entry { width: 100%; min-height: 200rpx; text-align: left; }.entry-copy { position: relative; flex: 1; min-width: 0; }.entry-title { display: block; font-size: 19px; font-family: SimSun, serif; line-height: 1.6; }
.entry-arrow { position: relative; display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 80rpx; height: 80rpx; border-radius: 50%; background: #ebc979; }.entry-arrow image { width: 20px; height: 20px; }
.journal-row { display: flex; align-items: center; gap: 16rpx; height: 188rpx; padding: 20rpx 12rpx 20rpx 24rpx; border: 1px solid #395250; border-radius: 32rpx; background: #0b2525; }
.journal-date { display: flex; flex-direction: column; gap: 4rpx; width: 112rpx; flex-shrink: 0; color: #a8b9b6; font-size: 12px; line-height: 1.6; }
.journal-thumb { width: 60rpx; height: 140rpx; flex-shrink: 0; border-radius: 8rpx; }
.journal-summary { flex: 1; min-width: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 13px; line-height: 20px; max-height: 40px; word-break: break-all; }
.record-page .more-button { width: 44px; height: 44px; flex-shrink: 0; color: #a8b9b6; font-size: 22px; }
.record-note,.empty-journal { display: block; color: #a8b9b6; font-size: 12px; line-height: 1.8; white-space: pre-line; }.empty-journal { padding: 24rpx 0; text-align: center; font-size: 14px; }
.record-nav { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; display: flex; padding: 0 24rpx env(safe-area-inset-bottom); border-top: 1px solid #395250; background: #031819; }
.record-nav button { flex: 1; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 6rpx; height: 132rpx; color: #a8b9b6; font-size: 12px; }.record-nav image { width: 48rpx; height: 48rpx; }.record-nav .is-active { color: #ebc979; }.active-line { width: 48rpx; height: 4rpx; background: #ebc979; border-radius: 2rpx; }
.journal-all { position: fixed; inset: 0; z-index: 20; background: #031819; display: flex; flex-direction: column; }.all-heading { display: flex; justify-content: space-between; align-items: center; padding: 0 24rpx; }.all-heading button { min-width: 44px; height: 44px; color: #ebc979; }.all-heading image { width: 20px; height: 20px; }.all-scroll { height: 0; flex: 1; padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); }.all-scroll .journal-row { margin-bottom: 24rpx; }
.detail-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(0,9,10,.7); }.detail-sheet { width: 100%; padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #0b2525; border-top: 1px solid #395250; }.detail-heading { display: flex; align-items: center; justify-content: space-between; }.detail-heading button { width: 44px; height: 44px; }.detail-heading image { width: 20px; height: 20px; }.detail-scroll { max-height: 60vh; }.detail-date,.detail-main,.journal-full { display: block; margin: 24rpx 0; font-size: 16px; line-height: 1.8; word-break: break-all; white-space: pre-wrap; }.record-page .edit-button { width: 100%; margin-top: 24rpx; min-height: 44px; background: #ebc979; color: #24312c; border-radius: 24rpx; }
