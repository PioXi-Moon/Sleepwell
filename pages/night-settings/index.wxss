page { background: #061719; }
.ns-page { height: 100vh; display: flex; flex-direction: column; background: linear-gradient(180deg, #020e14 0%, #061719 52%, #0a2422 100%); color: #f1ebdd; letter-spacing: 0; }
.ns-page button { margin: 0; padding: 0; background: transparent; color: inherit; font-size: 14px; line-height: 1.6; border-radius: 0; }
.ns-top { position: relative; flex-shrink: 0; text-align: center; }
.ns-top > text { position: absolute; bottom: 16px; left: 70px; right: 70px; font-size: 15px; }
.ns-page .ns-back { position: absolute; left: 16px; bottom: 4px; width: 44px; max-width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }.ns-back image { width: 20px; height: 20px; }
.ns-scroll { flex: 1; height: 0; width: 100%; }.ns-content { padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.ns-title { display: block; font-size: 24px; line-height: 1.5; margin-bottom: 36rpx; font-family: SimSun, serif; }
.ns-section { margin-bottom: 36rpx; }.ns-section-title { display: block; color: #ebc979; font-size: 18px; line-height: 1.6; padding: 16rpx 0; border-bottom: 1px solid #334647; }.ns-subheading { display: block; color: #a8b9b6; font-size: 12px; padding: 24rpx 0 8rpx; }
.ns-page .ns-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; max-width: 100%; min-height: 104rpx; padding: 20rpx 0; border-bottom: 1px solid rgba(168,185,182,.12); text-align: left; font-size: 14px; }.ns-row > view { flex: 1; min-width: 0; }.ns-row switch { flex-shrink: 0; }.ns-value { flex-shrink: 0; max-width: 48%; color: #a8b9b6; text-align: right; font-size: 13px; word-break: break-all; }.ns-help { display: block; font-size: 12px; line-height: 1.8; color: #a8b9b6; margin-top: 6rpx; }
.ns-memory { margin-top: 28rpx; padding: 16rpx 24rpx; background: #102426; border-left: 3px solid #ebc979; }.ns-memory-title { font-size: 18px; color: #ebc979; }.ns-memory .ns-row { border: 0; }.ns-memory-actions { display: flex; justify-content: space-between; gap: 16rpx; }.ns-memory-actions button { width: auto; max-width: 50%; min-height: 44px; }.ns-page .ns-danger { color: #e99898; }
.ns-overlay { position: fixed; inset: 0; z-index: 40; display: flex; align-items: flex-end; background: rgba(0,8,9,.7); }.ns-sheet { width: 100%; max-height: 82vh; padding-bottom: env(safe-area-inset-bottom); background: #102426; border-radius: 16rpx 16rpx 0 0; }.ns-sheet-heading { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 32rpx; font-size: 20px; }.ns-sheet-heading button { width: 44px; max-width: 44px; height: 44px; }.ns-sheet-heading image { width: 20px; height: 20px; }.ns-sheet-scroll { max-height: 62vh; }.ns-sheet-inner { padding: 0 32rpx 40rpx; }.ns-full { display: block; white-space: pre-wrap; word-break: break-all; font-size: 14px; line-height: 1.9; margin: 24rpx 0; }
