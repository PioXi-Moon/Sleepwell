.focus-page { min-height: 100vh; }
.focus-topbar { display: block; padding-left: 16rpx; }
.focus-topbar .focus-back { position: absolute; left: 8px; right: auto; bottom: 0; display: flex; align-items: center; justify-content: center; width: 48px; min-width: 48px; height: 48px; margin: 0; padding: 0; transform: none; border-radius: 8px; color: rgba(240,247,244,.9); background: transparent; }
.focus-back--pressed { background: rgba(255,255,255,.08); }
.focus-back-icon { position: relative; width: 24px; height: 24px; pointer-events: none; }
.focus-back-line { position: absolute; height: 2px; border-radius: 1px; background: currentColor; }
.focus-back-line--upper { left: 2px; top: 11px; width: 11px; transform-origin: 1px center; transform: rotate(-45deg); }
.focus-back-line--lower { left: 2px; top: 11px; width: 11px; transform-origin: 1px center; transform: rotate(45deg); }
.focus-back-line--stem { left: 3px; top: 11px; width: 19px; }
.focus-topbar .topbar-label { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); color: var(--text-soft); font-size: 28rpx; line-height: 20px; letter-spacing: 0; }
.topbar-spacer { width: 80rpx; }
.focus-content { padding: 56rpx 48rpx 72rpx; }
.focus-content .page-title { display: block; max-width: 580rpx; }
.focus-steps { margin: 70rpx 0 56rpx; }
.focus-step { display: flex; gap: 24rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }
.focus-step__number { display: flex; align-items: center; justify-content: center; flex: 0 0 48rpx; width: 48rpx; height: 48rpx; border: 1rpx solid rgba(204, 227, 194, 0.3); border-radius: 50%; color: var(--accent); }
.focus-step__title, .focus-step__detail { display: block; }
.focus-step__title { font-size: 29rpx; }
.focus-step__detail { margin-top: 10rpx; color: var(--text-soft); font-size: 24rpx; line-height: 1.6; }
.focus-message { display: block; margin-bottom: 32rpx; color: var(--accent); font-size: 23rpx; line-height: 1.7; }
